GROQ_API_KEY = "your-groq-api-key-here"
NEWS_API_KEY = "your-news-api-key-here"

# Optional — enables automatic fallback to Google's Gemini API whenever
# Groq's free-tier rate limit or daily quota is hit. Get a free key at
# https://aistudio.google.com/apikey (no credit card required). If this
# is left blank, the app behaves exactly as before: Groq errors surface
# as before with no fallback attempted.
GEMINI_API_KEY = "your-gemini-api-key-here"
