# EquiEye backend configuration.
# Copy to .env and fill in. NEVER commit the filled-in file.
#
# Every value is read via core/config.get_secret(), which checks OS
# environment variables first and falls back to Streamlit secrets only
# when running under Streamlit. That ordering is what lets the same
# services/ and modules/ code run on both hosts unchanged.

# ── Database ──────────────────────────────────────────────────────────────
# Unset -> SQLite at ./data/equieye.db (local dev only).
#
# MUST be set to Postgres in production: most PaaS filesystems are
# ephemeral, so a SQLite file is wiped on every redeploy — which is
# exactly the data loss the persistence layer exists to prevent.
# /api/health reports the live engine so a misconfiguration is visible.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ── API keys ──────────────────────────────────────────────────────────────
# Without GROQ_API_KEY the API still serves every numeric endpoint and
# reports ai_enabled:false; only the LLM routes degrade.
GROQ_API_KEY=
NEWS_API_KEY=
GEMINI_API_KEY=

# ── Models ────────────────────────────────────────────────────────────────
# Overridable because Groq retired llama-3.3-70b-versatile without notice
# and silently broke every AI call. Re-pointing a model is a config change,
# not a redeploy.
# LLM_MODEL_PRIMARY=openai/gpt-oss-120b
# LLM_MODEL_LIGHT=openai/gpt-oss-20b

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call this API. Defaults to
# http://localhost:3000 for local Next.js development.
# CORS_ORIGINS=http://localhost:3000,https://equieye.vercel.app
